datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                     String   @id @default(uuid())
  name                   String
  email                  String   @unique
  passwordHash           String
  role                   String   @default("Staff")
  failedLoginAttempts    Int      @default(0)
  lockUntil              DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  sessions               UserSession[]
  passwordResets         PasswordResetToken[]
  auditLogs              AuditLog[]
  purchasesUpdated       Purchase[] @relation(name: "PurchaseUpdatedBy")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Supplier {
  id                 String     @id @default(uuid())
  name               String
  phone              String?
  email              String?
  address            String?
  gstNumber          String?
  notes              String?
  outstandingBalance Float      @default(0.0)
  purchases          Purchase[]
  products           Product[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Customer {
  id                 String   @id @default(uuid())
  name               String
  phone              String   @unique
  email              String?
  address            String?
  gstNumber          String?
  creditLimit        Float    @default(0.0)
  outstandingBalance Float    @default(0.0)
  loyaltyPoints      Int      @default(0)
  sales              Sale[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Product {
  id                String         @id @default(uuid())
  name              String
  code              String         @unique
  barcode           String?        @unique
  categoryId        String
  category          Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brandId           String
  brand             Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  description       String?
  purchasePrice     Float
  sellingPrice      Float
  gstPercent        Float          @default(18.0)
  quantity          Int            @default(0)
  minQuantity       Int            @default(5)
  supplierId        String?
  supplier          Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  batchNumber       String?
  manufacturingDate DateTime?
  expiryDate        DateTime?
  imageUrl          String?
  status            String         @default("Active") // Active, Inactive
  purchaseItems     PurchaseItem[]
  saleItems         SaleItem[]
  inventoryLogs     InventoryLog[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([expiryDate])
}

model Purchase {
  id            String         @id @default(uuid())
  invoiceNumber String         @unique
  supplierId    String
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tax           Float          @default(0.0)
  totalAmount   Float
  amountPaid    Float          @default(0.0)
  paymentStatus String         @default("Pending") // Paid, Pending, Partial
  date          DateTime       @default(now())
  purchaseItems PurchaseItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  updatedById   String?
  updatedBy     User?          @relation(name: "PurchaseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model PurchaseItem {
  id          String   @id @default(uuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  costPrice   Float
  taxPercent  Float    @default(18.0)
  totalCost   Float
  createdAt   DateTime @default(now())
}

model Sale {
  id            String     @id @default(uuid())
  invoiceNumber String     @unique
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discount      Float      @default(0.0)
  gstAmount     Float      @default(0.0)
  totalAmount   Float
  profit        Float      @default(0.0)
  paymentMethod String     @default("Cash") // Cash, Card, UPI, Credit
  date          DateTime   @default(now())
  saleItems     SaleItem[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model SaleItem {
  id         String   @id @default(uuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int
  rate       Float
  discount   Float    @default(0.0)
  gstPercent Float    @default(18.0)
  totalCost  Float
  profit     Float    @default(0.0)
  createdAt  DateTime @default(now())
}

model InventoryLog {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        String   // In, Out, Adjust
  quantity    Int
  referenceId String?  // ID of purchase, sale, or custom reason
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  title     String
  message   String
  type      String           @default("General") // LowStock, Expiry, PaymentAlert, General
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model Setting {
  id              String   @id @default(uuid())
  companyName     String
  logoUrl         String?
  gstNumber       String?
  address         String?
  email           String?
  phone           String?
  currency        String   @default("INR")
  taxRate         Float    @default(18.0)
  invoiceTemplate String   @default("Standard")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserSession {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  refreshTokenHash  String
  deviceInfo        String?
  ipAddress         String?
  loginAt           DateTime @default(now())
  lastActivityAt    DateTime @default(now())
  expiresAt         DateTime
}

model PasswordResetToken {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  tokenHash   String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  timestamp DateTime @default(now())
}

